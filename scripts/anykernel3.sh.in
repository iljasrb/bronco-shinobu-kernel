### AnyKernel3 Ramdisk Mod Script
## Generated by scripts/make-anykernel3.sh. Do not edit the copy in the ZIP.

### AnyKernel setup
properties() { '
kernel.string=Shinobu Kernel @PROJECT_VERSION@
do.devicecheck=1
do.modules=0
do.systemless=0
do.cleanup=1
do.cleanuponabort=0
device.name1=bronco
device.name2=
device.name3=
device.name4=
device.name5=
supported.versions=
supported.patchlevels=
supported.vendorpatchlevels=
'; }

### AnyKernel install
# Only replace the kernel. Keep the stock ramdisk, cmdline and DTB from the
# target boot image; the vendor modules live in vendor_boot/vendor_dlkm.
BLOCK=boot;
IS_SLOT_DEVICE=1;
RAMDISK_COMPRESSION=auto;
PATCH_VBMETA_FLAG=auto;

# shellcheck disable=SC1091
. tools/ak3-core.sh;

current_lineage_version="$(getprop ro.lineage.version 2>/dev/null || true)";
ui_print " " "Shinobu Kernel @PROJECT_VERSION@";
ui_print " " "Kernel release: @KERNEL_RELEASE@";
ui_print " " "Package build: LineageOS @LINEAGEOS_BUILD@";

case "$current_lineage_version" in
  *"@LINEAGEOS_BUILD@"*) ;;
  "")
    ui_print " " "Warning: could not read ro.lineage.version; verify the target build.";
    ;;
  *)
    ui_print " " "Warning: running LineageOS $current_lineage_version, package is for @LINEAGEOS_BUILD@.";
    ui_print " " "This is expected when flashing the inactive slot after OTA; verify it.";
    ;;
esac;

# Do not run Magisk/KernelSU ramdisk patching. This kernel already contains
# BakaSU, and split_boot/flash_boot leave the target ramdisk contents unchanged.
NO_MAGISK_CHECK=1;
split_boot;
flash_boot;
