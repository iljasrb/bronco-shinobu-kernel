diff --git a/drivers/cpufreq/cpu_input_boost.c b/drivers/cpufreq/cpu_input_boost.c
new file mode 100644
index 000000000..10f547a9b
--- /dev/null
+++ b/drivers/cpufreq/cpu_input_boost.c
@@ -0,0 +1,303 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define BOOST_POLICY_COUNT 3
+#define MIN_INPUT_INTERVAL_MS 50
+
+struct boost_policy {
+	struct cpufreq_policy *policy;
+	struct freq_qos_request request;
+};
+
+/* SM8475 policies. */
+static struct boost_policy boost_policies[BOOST_POLICY_COUNT];
+static DEFINE_MUTEX(boost_lock);
+static struct workqueue_struct *boost_wq;
+static struct work_struct boost_work;
+static struct delayed_work unboost_work;
+static unsigned long last_input;
+static unsigned long boost_deadline;
+static bool boost_active;
+
+static unsigned int input_boost_duration_ms = 200;
+static unsigned int input_boost_freq_little = 998400;
+static unsigned int input_boost_freq_big = 1036800;
+static unsigned int input_boost_freq_prime = 979200;
+
+module_param_named(input_boost_duration_ms, input_boost_duration_ms, uint, 0644);
+module_param_named(input_boost_freq_little, input_boost_freq_little, uint, 0644);
+module_param_named(input_boost_freq_big, input_boost_freq_big, uint, 0644);
+module_param_named(input_boost_freq_prime, input_boost_freq_prime, uint, 0644);
+
+static unsigned int boost_frequency(struct cpufreq_policy *policy)
+{
+	unsigned int frequency;
+
+	if (cpumask_test_cpu(7, policy->related_cpus))
+		frequency = READ_ONCE(input_boost_freq_prime);
+	else if (cpumask_test_cpu(4, policy->related_cpus))
+		frequency = READ_ONCE(input_boost_freq_big);
+	else
+		frequency = READ_ONCE(input_boost_freq_little);
+
+	return min(frequency, policy->cpuinfo.max_freq);
+}
+
+static int add_boost_policy(struct cpufreq_policy *policy)
+{
+	struct boost_policy *available = NULL;
+	int i, ret = 0;
+
+	mutex_lock(&boost_lock);
+	for (i = 0; i < BOOST_POLICY_COUNT; i++) {
+		if (boost_policies[i].policy == policy)
+			goto out;
+		if (!boost_policies[i].policy && !available)
+			available = &boost_policies[i];
+	}
+	if (!available) {
+		ret = -ENOSPC;
+		goto out;
+	}
+
+	ret = freq_qos_add_request(&policy->constraints, &available->request,
+				   FREQ_QOS_MIN,
+				   boost_active ? boost_frequency(policy) : 0);
+	if (ret >= 0) {
+		available->policy = policy;
+		ret = 0;
+	}
+out:
+	mutex_unlock(&boost_lock);
+	return ret;
+}
+
+static void remove_boost_policy(struct cpufreq_policy *policy)
+{
+	int i, ret;
+
+	mutex_lock(&boost_lock);
+	for (i = 0; i < BOOST_POLICY_COUNT; i++) {
+		if (boost_policies[i].policy != policy)
+			continue;
+		ret = freq_qos_remove_request(&boost_policies[i].request);
+		if (ret < 0)
+			pr_err("cpu_input_boost: failed to remove policy: %d\n", ret);
+		boost_policies[i].policy = NULL;
+		break;
+	}
+	mutex_unlock(&boost_lock);
+}
+
+static void remove_all_boost_policies(void)
+{
+	int i, ret;
+
+	mutex_lock(&boost_lock);
+	for (i = 0; i < BOOST_POLICY_COUNT; i++) {
+		if (!boost_policies[i].policy)
+			continue;
+		ret = freq_qos_remove_request(&boost_policies[i].request);
+		if (ret < 0)
+			pr_err("cpu_input_boost: failed to remove policy: %d\n", ret);
+		boost_policies[i].policy = NULL;
+	}
+	mutex_unlock(&boost_lock);
+}
+
+static int boost_policy_event(struct notifier_block *nb,
+			      unsigned long event, void *data)
+{
+	struct cpufreq_policy *policy = data;
+	int ret;
+
+	if (event == CPUFREQ_CREATE_POLICY) {
+		ret = add_boost_policy(policy);
+		if (ret)
+			pr_err("cpu_input_boost: failed to add policy: %d\n", ret);
+	} else if (event == CPUFREQ_REMOVE_POLICY) {
+		remove_boost_policy(policy);
+	}
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block boost_policy_notifier = {
+	.notifier_call = boost_policy_event,
+};
+
+static void set_boost(bool enabled)
+{
+	unsigned int frequency;
+	int i, ret;
+
+	mutex_lock(&boost_lock);
+	boost_active = enabled;
+	for (i = 0; i < BOOST_POLICY_COUNT; i++) {
+		if (!boost_policies[i].policy)
+			continue;
+		frequency = enabled ? boost_frequency(boost_policies[i].policy) : 0;
+		ret = freq_qos_update_request(&boost_policies[i].request, frequency);
+		if (ret < 0)
+			pr_err("cpu_input_boost: failed to update policy: %d\n", ret);
+	}
+	mutex_unlock(&boost_lock);
+}
+
+static void apply_boost(struct work_struct *work)
+{
+	unsigned long deadline, delay;
+
+	set_boost(true);
+	deadline = READ_ONCE(boost_deadline);
+	delay = time_after(deadline, jiffies) ? deadline - jiffies : 0;
+	mod_delayed_work(boost_wq, &unboost_work, delay);
+}
+
+static void remove_boost(struct work_struct *work)
+{
+	unsigned long deadline = READ_ONCE(boost_deadline);
+
+	if (time_before(jiffies, deadline)) {
+		mod_delayed_work(boost_wq, &unboost_work, deadline - jiffies);
+		return;
+	}
+	set_boost(false);
+}
+
+static void input_boost_event(struct input_handle *handle, unsigned int type,
+			      unsigned int code, int value)
+{
+	unsigned long now = jiffies;
+
+	if (time_before(now, READ_ONCE(last_input) +
+			msecs_to_jiffies(MIN_INPUT_INTERVAL_MS)))
+		return;
+	WRITE_ONCE(last_input, now);
+	WRITE_ONCE(boost_deadline, now +
+		   msecs_to_jiffies(READ_ONCE(input_boost_duration_ms)));
+	queue_work(boost_wq, &boost_work);
+}
+
+static int input_boost_connect(struct input_handler *handler,
+			       struct input_dev *dev,
+			       const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int ret;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "cpu-input-boost";
+
+	ret = input_register_handle(handle);
+	if (ret)
+		goto free_handle;
+	ret = input_open_device(handle);
+	if (ret)
+		goto unregister_handle;
+	return 0;
+
+unregister_handle:
+	input_unregister_handle(handle);
+free_handle:
+	kfree(handle);
+	return ret;
+}
+
+static void input_boost_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id input_boost_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT |
+			 INPUT_DEVICE_ID_MATCH_ABSBIT,
+		.evbit = { BIT_MASK(EV_ABS) },
+		.absbit = { [BIT_WORD(ABS_MT_POSITION_X)] =
+			BIT_MASK(ABS_MT_POSITION_X) |
+			BIT_MASK(ABS_MT_POSITION_Y) },
+	},
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+	},
+	{ },
+};
+
+static struct input_handler input_boost_handler = {
+	.event = input_boost_event,
+	.connect = input_boost_connect,
+	.disconnect = input_boost_disconnect,
+	.name = "cpu-input-boost",
+	.id_table = input_boost_ids,
+};
+
+static void add_existing_policies(void)
+{
+	struct cpufreq_policy *policy;
+	unsigned int cpu;
+	int ret;
+
+	get_online_cpus();
+	for_each_online_cpu(cpu) {
+		policy = cpufreq_cpu_get(cpu);
+		if (!policy)
+			continue;
+		ret = add_boost_policy(policy);
+		if (ret)
+			pr_err("cpu_input_boost: failed to add CPU%u policy: %d\n",
+			       cpu, ret);
+		cpufreq_cpu_put(policy);
+	}
+	put_online_cpus();
+}
+
+static int __init cpu_input_boost_init(void)
+{
+	int ret;
+
+	boost_wq = alloc_ordered_workqueue("cpu_input_boost",
+					   WQ_HIGHPRI | WQ_MEM_RECLAIM);
+	if (!boost_wq)
+		return -ENOMEM;
+	INIT_WORK(&boost_work, apply_boost);
+	INIT_DELAYED_WORK(&unboost_work, remove_boost);
+
+	ret = cpufreq_register_notifier(&boost_policy_notifier,
+					CPUFREQ_POLICY_NOTIFIER);
+	if (ret)
+		goto destroy_workqueue;
+	add_existing_policies();
+
+	ret = input_register_handler(&input_boost_handler);
+	if (ret)
+		goto unregister_notifier;
+	return 0;
+
+unregister_notifier:
+	cpufreq_unregister_notifier(&boost_policy_notifier,
+				    CPUFREQ_POLICY_NOTIFIER);
+	remove_all_boost_policies();
+destroy_workqueue:
+	destroy_workqueue(boost_wq);
+	return ret;
+}
+late_initcall(cpu_input_boost_init);
+
+MODULE_DESCRIPTION("SM8475 input CPU frequency boost");
+MODULE_LICENSE("GPL");
