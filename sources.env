# Pinned source set for ThinkPhone Shinobu Kernel.

# Displayed by compatible BakaSU managers in the integrated driver's Version field.
PROJECT_VERSION="0.4.1"
LINEAGE_BRANCH="lineage-24.0"

KERNEL_REPOSITORY="https://github.com/LineageOS/android_kernel_motorola_sm8475.git"
KERNEL_BRANCH="$LINEAGE_BRANCH"
KERNEL_REVISION="0e4b4e9fccd77aa387944368da3949e01e580111"
KERNEL_DIRECTORY="kernel"

DEVICE_TREE_REPOSITORY="https://github.com/LineageOS/android_kernel_motorola_sm8475-devicetrees.git"
DEVICE_TREE_BRANCH="$LINEAGE_BRANCH"
DEVICE_TREE_REVISION="4d2ea0ebf7a591e2c98d682a106afe4605616724"
DEVICE_TREE_DIRECTORY="kernel-devicetrees"

BAKASU_REPOSITORY="https://github.com/Baka-SU/BakaSU.git"
# main has `kernel: suspend susfs build` (48fa4bb7), so SUSFS ROMs track sync-susfs
BAKASU_BRANCH="sync-susfs"
BAKASU_REVISION="f308ed0936bdd31163cb53da3f42bc7a698f5512"
BAKASU_DIRECTORY="KernelSU"

# Reproduces patches/0001-susfs.patch; refresh it after changing this pin.
SUSFS_REPOSITORY="https://gitlab.com/simonpunk/susfs4ksu.git"
SUSFS_BRANCH="gki-android13-5.10"
SUSFS_REVISION="5326e21a7eb232f9e21debdd5164e99bee3d1e2f"

# maxsteeel's original NoMount engine; userspace comes from its metamodule.
NOMOUNT_REPOSITORY="https://github.com/maxsteeel/nomount.git"
NOMOUNT_BRANCH="master"
NOMOUNT_REVISION="c7f63e3feb4125d591b6969a33aac04feb40f8ba"
NOMOUNT_DIRECTORY="NoMount"

MKBOOTIMG_REPOSITORY="https://android.googlesource.com/platform/system/tools/mkbootimg.git"
MKBOOTIMG_BRANCH="main"
MKBOOTIMG_REVISION="d2bb0af5ba6d3198a3e99529c97eda1be0b5a093"
MKBOOTIMG_DIRECTORY="tools/mkbootimg"

ANDROID_CLANG_REPOSITORY="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86.git"
ANDROID_CLANG_REF="android-17.0.0_r1"
ANDROID_CLANG_REVISION="29182889399818f97baa65ea238c80e8117981eb"
ANDROID_CLANG_DIRECTORY="clang-r584948"
ANDROID_CLANG_PATH="tools/android-clang/clang-r584948"

BOOT_IMAGE_URL="https://mirrorbits.lineageos.org/full/bronco/20261018/boot.img"
BOOT_IMAGE_SHA256="10e76d0d7de89ae5beefb1dcf861d428b550f4f0768c3c2bb5b14ced14082a56"
